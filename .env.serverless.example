# Function Compute runtime
STORAGE_DRIVER=oss
SERVER_MANAGED_MODEL_KEYS=1
TZ=Asia/Shanghai

# Application login. Replace both values before deployment.
APP_USERNAME=teacher
APP_PASSWORD=replace-with-a-long-random-password

# Private OSS bucket in the same region as Function Compute.
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=replace-with-your-private-bucket
# The function uses this same-region internal endpoint for server-side data access.
# Browser image uploads and downloads continue to use the public endpoint.
OSS_INTERNAL_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_DATA_OBJECT=essay-grading/data/app-data.json
OSS_ASSET_PREFIX=essay-grading/assets
OSS_SIGNED_URL_TTL_SECONDS=21600

# Model credentials. Configure only the providers you use.
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
KIMI_API_KEY=replace-with-kimi-api-key

# Optional generic overrides.
# MODEL_API_KEY=
# VISION_API_KEY=
# JUDGE_API_KEY=
